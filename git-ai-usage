#!/usr/bin/env python3
"""git ai-usage: record local AI coding-agent usage per commit in git notes.

Reads the Claude Code transcripts on this machine (~/.claude/projects/**/*.jsonl) and writes,
for each of your commits, the tokens and the derived cost of the work done in the repository
since your previous commit. The data goes to the notes ref refs/notes/ai-usage, so commit SHAs
do not change and past commits can be backfilled.

A commit gets the usage between your previous commit and its author date, from transcripts
whose working directory is inside the repository (or one of its worktrees). Each usage record
belongs to exactly one window, so no record is counted twice.

Note format, one line per model (plus one line for edited lines):

    claude-code model=claude-opus-4-1 in=1200 out=5400 cache_read=230000 cache_write=12000 cost_usd=1.8400 from=1791000000 to=1791003600
    claude-code added=120 deleted=14 from=1791000000 to=1791003600

Readers sum the numeric keys of the unique lines. The window (from, to) makes a line unique, so
a note copied twice by an amend is counted once and a squash keeps the lines of both commits.
"""

from __future__ import annotations

import argparse
import bisect
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

__version__ = "0.1.0"

