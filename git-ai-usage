class UsageError(RuntimeError):
    """A problem the user can fix, shown without a traceback."""


# --- git ----------------------------------------------------------------------


def git(*args: str, check: bool = True, stdin: str | None = None) -> str:
    """Run git and return its stdout. The output is not stripped: callers use control-character
    separators, and str.strip() removes them as whitespace."""
    result = subprocess.run(
        ["git", *args],
        input=stdin,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if check and result.returncode != 0:
        raise UsageError(f"git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout


def git_ok(*args: str) -> bool:
    return subprocess.run(["git", *args], capture_output=True).returncode == 0


def repo_roots() -> list[str]:
    """The paths of all worktrees of this repository."""
    roots = [line[len("worktree ") :] for line in git("worktree", "list", "--porcelain").splitlines() if line.startswith("worktree ")]
    if not roots:
        roots = [git("rev-parse", "--show-toplevel").rstrip("\n")]
    return [os.path.realpath(root) for root in roots]


def user_email() -> str:
    email = git("config", "user.email", check=False).rstrip("\n")
    if not email:
        raise UsageError("git config user.email is not set")
    return email


@dataclass(frozen=True)
class Commit:
    sha: str
    author_time: int
    email: str
    subject: str


def list_commits(*rev_args: str) -> list[Commit]:
    output = git("log", "--no-merges", "--format=%H%x1f%at%x1f%ae%x1f%s%x1e", *rev_args)
    commits = []
    for record in output.split("\x1e"):
        record = record.lstrip("\n")
        if not record:
            continue
        sha, author_time, email, subject = record.split("\x1f", 3)
        commits.append(Commit(sha, int(author_time), email, subject))
    return commits


def own_commits(email: str, commits: list[Commit] | None = None) -> list[Commit]:
    commits = list_commits(*CODE_REFS) if commits is None else commits
    return [commit for commit in commits if commit.email.lower() == email.lower()]


def own_commit_times(email: str, commits: list[Commit] | None = None) -> list[int]:
    """Sorted unique author times of your commits. They are the window bounds."""
    return sorted({commit.author_time for commit in own_commits(email, commits)})


def read_note(sha: str) -> str:
    return git("notes", f"--ref={NOTES_REF}", "show", sha, check=False)


def notes_by_commit(rev_args: list[str]) -> list[tuple[Commit, str]]:
    output = git(
        "log", "--no-merges", "--no-notes", f"--notes={NOTES_REF}",
        "--format=%H%x1f%at%x1f%ae%x1f%s%x1f%N%x1e", *rev_args,
    )
    result = []
    for record in output.split("\x1e"):
        record = record.lstrip("\n")
        if not record:
            continue
        sha, author_time, email, subject, note = record.split("\x1f", 4)
        result.append((Commit(sha, int(author_time), email, subject), note))
    return result


def write_note(sha: str, text: str) -> None:
    git("notes", f"--ref={NOTES_REF}", "add", "-f", "-F", "-", sha, stdin=text)


# --- transcripts --------------------------------------------------------------


def claude_projects_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"


def encode_project(path: str) -> str:
    """Claude Code names a project folder after its working directory, with every
    non-alphanumeric character replaced by '-'."""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def project_dirs(roots: list[str]) -> list[Path]:
    base = claude_projects_dir()
    if not base.is_dir():
        return []
    dirs = [entry for entry in base.iterdir() if entry.is_dir()]
    prefixes = [encode_project(root) for root in roots]
    matched = [entry for entry in dirs if any(entry.name == p or entry.name.startswith(p + "-") for p in prefixes)]
    # The folder name is a hint only; if it does not match, the cwd of each record still decides.
    return matched or dirs


def inside(cwd: str, roots: list[str]) -> bool:
    if not cwd:
        return False
    path = os.path.realpath(cwd)
    return any(path == root or path.startswith(root.rstrip("/") + "/") for root in roots)


def parse_time(value: str) -> float:
    # Python before 3.11 does not accept a "Z" suffix.
    return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc).timestamp()


@dataclass
class Call:
    """One assistant API call, deduplicated by message id."""

    when: float
    model: str
    fast: bool
    tokens: dict
    tool: str = CLAUDE_TOOL
    tier: str = ""


@dataclass
class Edit:
    when: float
    added: int
    deleted: int
    tool: str = CLAUDE_TOOL
    # The non-blank text of the lines, by file path: {path: (added lines, deleted lines)}.
    texts: dict = field(default_factory=dict)


def edited_lines(result: dict) -> tuple[int, int]:
    added = deleted = 0
    for hunk in result.get("structuredPatch") or []:
        for line in hunk.get("lines", []):
            added += line.startswith("+")
            deleted += line.startswith("-")
    if result.get("type") == "create":
        added += len((result.get("content") or "").split("\n"))
    return added, deleted


def _texts(lines: list) -> list[str]:
    return [text for text in (str(line).strip() for line in lines) if text]


def edit_texts(result: dict) -> dict:
    """The lines of one Claude Code edit, by file path."""
    path = str(result.get("filePath") or "")
    if not path:
        return {}
    added, deleted = [], []
    for hunk in result.get("structuredPatch") or []:
        for line in hunk.get("lines", []):
            if line.startswith("+"):
                added.append(line[1:])
            elif line.startswith("-"):
                deleted.append(line[1:])
    if result.get("type") == "create":
        added += (result.get("content") or "").split("\n")
    return {path: (_texts(added), _texts(deleted))}


def read_transcripts(roots: list[str], since: float | None = None) -> tuple[list[Call], list[Edit]]:
    """All usage recorded in the repository, from transcripts changed after `since`.

    Claude Code writes one line per content block, and an early line can carry a partial output
    count, so a message keeps the largest value seen for each field. Resumed sessions copy old
    records into a new file: the message id and the record uuid remove those copies.
    """
    calls: dict[str, Call] = {}
    edits: dict[str, Edit] = {}
    for folder in project_dirs(roots):
        for path in folder.rglob("*.jsonl"):
            try:
                if since is not None and path.stat().st_mtime < since:
                    continue
                handle = path.open(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            with handle:
                for line in handle:
                    if '"assistant"' not in line and '"toolUseResult"' not in line:
                        continue
                    try:
                        _read_record(json.loads(line), roots, calls, edits)
                    except (ValueError, KeyError, TypeError, AttributeError):
                        # An open session has a half-written last line.
                        continue
    return list(calls.values()), list(edits.values())


def _read_record(record: dict, roots: list[str], calls: dict, edits: dict) -> None:
    if not record.get("timestamp") or not inside(record.get("cwd", ""), roots):
        return
    when = parse_time(record["timestamp"])
    if record.get("type") == "assistant":
        message = record["message"]
        usage = message.get("usage") or {}
        if not usage:
            return
        tokens = {
            "in": usage.get("input_tokens", 0) or 0,
            "out": usage.get("output_tokens", 0) or 0,
            "cache_write": usage.get("cache_creation_input_tokens", 0) or 0,
            "cache_read": usage.get("cache_read_input_tokens", 0) or 0,
            "cache_write_1h": (usage.get("cache_creation") or {}).get("ephemeral_1h_input_tokens", 0) or 0,
            "web_search": (usage.get("server_tool_use") or {}).get("web_search_requests", 0) or 0,
        }
        key = message.get("id") or record.get("uuid")
        previous = calls.get(key)
        if previous:
            previous.tokens = {name: max(value, previous.tokens[name]) for name, value in tokens.items()}
            return
        calls[key] = Call(when, message.get("model", ""), usage.get("speed") == "fast", tokens)
        return
    result = record.get("toolUseResult")
    if isinstance(result, dict) and record.get("uuid"):
        added, deleted = edited_lines(result)
        if added or deleted:
            edits[record["uuid"]] = Edit(when, added, deleted, texts=edit_texts(result))


def tier_for(model: str, fast: bool = False) -> str | None:
    for table in ((FAST_MODE_TIERS if fast else {}), MODEL_TIERS):
        if model in table:
            return table[model]
        for key in sorted(table, key=len, reverse=True):
            if key in model:
                return table[key]
    return None


def rates_for(model: str, fast: bool = False) -> dict | None:
    """A tier's rates, with the higher ones a long prompt pays (Haiku 5.5 above 100K) under "long"."""
    tier = tier_for(model, fast)
    if tier is None:
        return None
    limit, long_tier = LONG_PROMPT_TIERS.get(tier, (None, None))
    return {**PRICING_TIERS[tier], "long": [limit, PRICING_TIERS[long_tier]] if limit is not None else None}


def cost_usd(call: Call) -> float:
    return priced(call)[0]


def priced(call: Call) -> tuple[float, str]:
    """Cost of one call or response and where its rates came from. Long-context rates depend on
    the prompt of one request, so never price a sum."""
    rates, source = call_rates(call)
    if not rates:
        return 0.0, source
    tokens = call.tokens
    written = tokens["cache_write"]
    long = rates.get("long")
    if long and tokens["in"] + tokens["cache_read"] + written > long[0]:
        rates = {**rates, **{key: value for key, value in long[1].items() if value is not None}}
    input_rate = rates["input"]
    write = input_rate if rates.get("cache_write") is None else rates["cache_write"]
    write_1h = 2 * input_rate if rates.get("cache_write_1h") is None else rates["cache_write_1h"]
    read = input_rate if rates.get("cache_read") is None else rates["cache_read"]
    one_hour = min(tokens.get("cache_write_1h", 0), written)
    per_million = (
        tokens["in"] * input_rate
        + tokens["cache_read"] * read
        + (written - one_hour) * write
        + one_hour * write_1h
        + tokens["out"] * rates["output"]
    )
    return per_million / 1_000_000 + tokens.get("web_search", 0) * WEB_SEARCH_USD, source


